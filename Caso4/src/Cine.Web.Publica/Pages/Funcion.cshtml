@page "/funcion/{funcionId:int}"
@using System.Globalization
@using Cine.Nucleo.Dominio
@model FuncionModel
@{
    var cultura = new CultureInfo("es-CR");
    ViewData["Title"] = Model.Mapa is null ? "Función no encontrada" : Model.Mapa.Titulo;
}

@if (Model.Mapa is null)
{
    <h1>Función no encontrada</h1>
    <p class="vacio">Esa función no existe en la cartelera. <a asp-page="/Index">Volver a la cartelera</a>.</p>
    return;
}

<h1>@Model.Mapa.Titulo</h1>
<p class="semana">
    @Model.Mapa.SalaNombre &middot;
    @Model.Mapa.InicioLocal.ToString("dddd d 'de' MMMM 'a las' HH:mm", cultura) &middot;
    @(Model.Mapa.ClasificacionEdad == 0 ? "todo público" : $"{Model.Mapa.ClasificacionEdad} años")
</p>

<p class="pantalla">PANTALLA</p>

<div id="mapa" class="mapa" data-funcion-id="@Model.Mapa.FuncionId">
    @foreach (var fila in Model.Filas)
    {
        <div class="fila">
            <span class="letra">@fila.Key</span>
            @foreach (var butaca in fila.OrderBy(b => b.Numero))
            {
                <span class="butaca @butaca.Estado.ToString().ToLowerInvariant()"
                      data-butaca="@butaca.Fila@butaca.Numero"
                      title="@butaca.Fila@butaca.Numero — @butaca.Estado">@butaca.Numero</span>
            }
        </div>
    }
</div>

<ul class="leyenda">
    <li><span class="butaca libre"></span> libre</li>
    <li><span class="butaca mia"></span> suya</li>
    <li><span class="butaca apartada"></span> apartada</li>
    <li><span class="butaca vendida"></span> vendida</li>
    <li><span class="butaca novendible"></span> no vendible</li>
</ul>

<p class="aviso" id="aviso">El mapa se actualiza solo cada 5 segundos.</p>

<section class="compra" id="compra" data-tarifa="@FuncionModel.TarifaGeneral">
    <p id="seleccion">Toque las butacas que quiere. Cada una queda apartada 10 minutos.</p>
    <p id="plazo" hidden></p>
    <label for="correo">Correo (opcional, para recibir el código)</label>
    <input type="email" id="correo" name="correo" autocomplete="email" placeholder="nombre@ejemplo.cr" />
    <button type="button" id="pagar" disabled>Pagar</button>
    <p class="error" id="error" hidden></p>
</section>

<section class="confirmacion" id="confirmacion" hidden>
    <h2>Compra confirmada</h2>
    <p>Su código es <strong id="codigo"></strong>. Preséntelo en la puerta.</p>
    <p id="detalleCompra"></p>
</section>

@section Scripts {
    <script src="~/js/mapa.js" asp-append-version="true"></script>
}

@{
    var version = System.Reflection.Assembly.GetAssembly(typeof(Cine.Nucleo.Servicios.ServicioCartelera))!
        .GetName().Version?.ToString() ?? "desconocida";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#07070d" />
    <title>@ViewData["Title"] - Cine Variedades</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/cine.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky top-0 z-20 border-b border-white/10 bg-sala-950/80 backdrop-blur">
        <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-3">
            <a asp-page="/Index" class="flex items-center gap-2">
                <span class="grid h-8 w-8 place-items-center rounded-lg bg-gradient-to-br from-marquesina-400 to-marquesina-600 font-display text-lg text-sala-950">CV</span>
                <span class="font-display text-2xl tracking-widest text-slate-100">Cine Variedades</span>
            </a>
            <span class="hidden text-xs text-slate-500 sm:block">dos salas &middot; butaca numerada</span>
        </div>
    </header>

    <main class="mx-auto w-full max-w-3xl px-4 py-6">
        @RenderBody()
    </main>

    <footer class="mx-auto max-w-3xl px-4 pb-10 pt-4 text-center text-xs text-slate-600">
        Cine Variedades &middot; núcleo @version
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>d01d66e5-c389-4952-a51d-8ccc155c3fb7</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Visibilidad para que el proyecto de pruebas use WebApplicationFactory<Program> —
         no cambia ningún comportamiento de la app, solo visibilidad en tiempo de compilación. -->
    <InternalsVisibleTo Include="MileageClaims.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Modules\Rates\MileageClaims.Modules.Rates.csproj" />
    <ProjectReference Include="..\Modules\Distances\MileageClaims.Modules.Distances.csproj" />
    <ProjectReference Include="..\Modules\Integrations\MileageClaims.Modules.Integrations.csproj" />
    <ProjectReference Include="..\Modules\Notifications\MileageClaims.Modules.Notifications.csproj" />
    <ProjectReference Include="..\Modules\Claims\MileageClaims.Modules.Claims.csproj" />
    <ProjectReference Include="..\Modules\Approvals\MileageClaims.Modules.Approvals.csproj" />
    <ProjectReference Include="..\Modules\Scheduling\MileageClaims.Modules.Scheduling.csproj" />
    <ProjectReference Include="..\Modules\Reporting\MileageClaims.Modules.Reporting.csproj" />
    <ProjectReference Include="..\Infrastructure\MileageClaims.Infrastructure.csproj" />
  </ItemGroup>

</Project>
